# SAFENET Environment Configuration Template
# Copy this file to .env.local to configure optional external services.
# The core SAFENET intelligence pipeline (DNS, RDAP, TLS, HTTP, HTML, heuristic risk) functions fully without external keys.

# ==============================================================================
# Optional AI Interpretation (Google Gemini 1.5 Flash)
# ==============================================================================
# If configured, Gemini interprets structured technical evidence without inventing facts.
# If omitted or invalid, the pipeline falls back gracefully to deterministic rule-based explainability.
GEMINI_API_KEY=

# ==============================================================================
# Optional Threat Intelligence Feeds
# ==============================================================================
# Google Safe Browsing Lookup API v4 key
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API v3 key
VIRUSTOTAL_API_KEY=

# ==============================================================================
# Intelligence Pipeline Operational Limits
# ==============================================================================
# Total timeout budget for a complete multi-source intelligence scan in milliseconds (default: 8000)
SAFENET_SCAN_TIMEOUT_MS=8000

# Maximum bytes to read during read-only HTTP webpage inspection (default: 524288 = 512 KB)
SAFENET_MAX_RESPONSE_BYTES=524288

# Maximum HTTP redirect hops before stopping inspection (default: 5)
SAFENET_MAX_REDIRECTS=5

# ==============================================================================
# Application URL Configuration
# ==============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
